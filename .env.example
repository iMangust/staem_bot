# === Скопируйте этот файл в .env и заполните значениями ===

# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=123456789:AAYourTokenHere

# Ваш числовой Telegram ID (узнать: @userinfobot) (обязательно)
ADMIN_USER_ID=123456789

# Интервал автопроверки бесплатных игр, минут (по умолчанию 60)
CHECK_INTERVAL=60

# Сколько страниц поиска бесплатных игр просматривать (по умолчанию 5)
MAX_SEARCH_PAGES=5

# Сколько страниц просматривать при поиске скидок (по умолчанию 3)
MAX_DISCOUNT_PAGES=3

# Лимит скидочных игр в одном отчёте (по умолчанию 50)
MAX_DISCOUNT_GAMES=50

# Опционально: ключ Steam Web API (https://steamcommunity.com/dev/apikey)
# Ускоряет кэш библиотеки (GetOwnedGames). Без него кэш работает по cookies.
STEAM_API_KEY=
